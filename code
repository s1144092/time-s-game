<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>12小時與24小時報時制 - 卡牌記憶對對碰</title>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@600;700;800&family=Work+Sans:wght@400;600;700;900&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#06D6A0',
            background: '#F0FFF4',
            cardBg: '#D1FAE5',
            accent: '#EF476F',
            foreground: '#064E3B',
          },
          fontFamily: {
            heading: ['Quicksand', 'sans-serif'],
            body: ['Work Sans', 'sans-serif'],
          }
        }
      }
    }
