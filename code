  <style>
    body {
      background-color: #F0FFF4;
      color: #064E3B;
      font-family: 'Work Sans', sans-serif;
      user-select: none;
    }

    .font-heading {
      font-family: 'Quicksand', sans-serif;
    }

    /* 網格等高補正 */
    #card-grid {
      grid-auto-rows: 1fr;
    }

    /* 3D 卡牌翻轉容器 */
    .card-container {
      perspective: 1000px;
    }

    .card-inner {
      position: relative;
      width: 100%;
      height: 100%;
      transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1);
      transform-style: preserve-3d;
    }

    .card-container.flipped .card-inner {
      transform: rotateY(180deg);
    }

    .card-front, .card-back {
      position: absolute;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      border-radius: 1rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 6px -1px rgba(6, 78, 59, 0.1), 0 2px 4px -1px rgba(6, 78, 59, 0.06);
    }

    /* 卡牌背面 */
    .card-back {
      background: linear-gradient(135deg, #06D6A0 0%, #05B386 100%);
      border: 3px solid #FFFFFF;
      transform: rotateY(0deg);
    }

    /* 卡牌正面 */
    .card-front {
      background-color: #FFFFFF;
      border: 3px solid #06D6A0;
      transform: rotateY(180deg);
    }

    /* 淡出隱藏（保持網格排版不塌陷） */
    .card-matched {
      transition: opacity 1s ease-out, visibility 1s;
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
    }

    /* 倒數警告閃爍 */
    @keyframes blink {
      0%, 100% { color: #EF476F; }
      50% { color: #991B1B; opacity: 0.5; }
    }
    .timer-warning {
      animation: blink 1s infinite;
    }

    /* 超大倒數數字彈跳出現動畫 */
    @keyframes popIn {
      0% {
        transform: scale(0.2);
        opacity: 0;
      }
      50% {
        transform: scale(1.2);
        opacity: 1;
      }
      100% {
        transform: scale(1);
        opacity: 1;
      }
    }
    .animate-pop {
      animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    /* 歡慶 Canvas */
    #confetti-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 50;
    }
  </style>
</head>
